# ---------------------------------------------------------------
# School ERP agent - LLM backend configuration
#
# Usage (Windows PowerShell, from the repo root):
#   Copy-Item .env.example .env
#   # then edit .env and uncomment ONE block below
#
# Real environment variables override this file:
#   $env:LLM_PROVIDER="openai"  # wins over the file
# ---------------------------------------------------------------

# Option 1 - LOCAL Ollama (default; no edits needed when you have it)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
# LLM_MAX_TOKENS=512

# Option 2 - GROQ free tier (no install, free models incl. llama)
# Get a free key (starts with gsk_) at https://console.groq.com
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_MODEL=llama-3.3-70b-versatile
#LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
#LLM_MAX_TOKENS=1024

# Option 3 - any LOCAL OpenAI-compatible server (LM Studio / Jan)
# Start LM Studio, load a model, note the exact model name shown in the UI:
#LLM_PROVIDER=openai
#LLM_BASE_URL=http://localhost:1234/v1
#LLM_MODEL=model-name-from-lm-studio
#LLM_MAX_TOKENS=1024